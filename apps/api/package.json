{
  "name": "@sentinel/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file .env src/index.ts",
    "build": "tsc --project tsconfig.json",
    "start": "node --env-file .env dist/index.js",
    "typecheck": "tsc --noEmit",
    "migrate": "tsx --env-file .env src/db/migrate.ts",
    "migrate:ci": "tsx src/db/migrate.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@sentinel/shared": "workspace:*",
    "basic-ftp": "^6.2.6",
    "fastify": "^5.12.8",
    "nanoid": "^5.1.16",
    "p-limit": "^6.2.0",
    "pg": "^8.23.1",
    "pino": "^9.14.0",
    "prom-client": "^15.1.3",
    "undici": "^6.29.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^4.1.12",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
