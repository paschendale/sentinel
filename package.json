{
  "name": "sentinel",
  "private": true,
  "version": "1.28.0",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "scripts": {
    "dev": "pnpm --filter @sentinel/shared build && pnpm --parallel -r dev",
    "dev:api": "pnpm --filter @sentinel/api dev",
    "dev:web": "pnpm --filter @sentinel/web dev",
    "migrate": "pnpm --filter @sentinel/api migrate",
    "test": "pnpm --filter @sentinel/api test",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^11.0.6",
    "@semantic-release/npm": "^12.0.2",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "semantic-release": "^24.2.9",
    "typescript": "^5.9.3"
  }
}
